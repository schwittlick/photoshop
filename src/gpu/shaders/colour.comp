#version 430
// Stage 1: white balance, highlight clamp, camera -> working space, vignetting.
// Runs in the source frame on one mip level of the source texture.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D uSrc;
layout(binding = 1) uniform sampler1D uVigLut;
layout(rgba16f, binding = 0) uniform writeonly image2D uDst;

uniform int uLevel;
uniform ivec2 uSize;
uniform vec3 uInvPreMul;     // undoes LibRaw's pre-scaling: normalised raw clips at 1.0 per channel
uniform vec3 uWbMul;         // user white balance multipliers, green = 1
uniform mat3 uCamToWork;
uniform int uHighlightMode;  // 0 none, 1 clamp blown pixels towards neutral (see spec §9)
uniform int uVigMode;        // bit0: profile LUT, bit1: manual
uniform float uProfileVigStrength;
uniform float uVigAmount;    // manual, -1..1 (positive brightens corners)
uniform float uVigMidpoint;  // 0..1
uniform vec2 uHalfDiagScale; // maps centred normalised coords to r (1 = corner)

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= uSize.x || p.y >= uSize.y) return;
    vec3 u = texelFetch(uSrc, p, uLevel).rgb;
    vec3 r = u * uInvPreMul;
    float mx = max(r.r, max(r.g, r.b));
    vec3 wb = r * uWbMul;
    if (uHighlightMode == 1) {
        // Blown pixels: clamp every channel to the lowest clipping point so they go neutral
        // instead of magenta/cyan. Soft transition to avoid a hard edge around clipped areas.
        float t = smoothstep(0.9, 1.0, mx);
        float minw = min(uWbMul.r, min(uWbMul.g, uWbMul.b));
        wb = mix(wb, min(wb, vec3(minw)), t);
    }
    float gain = 1.0;
    if (uVigMode != 0) {
        vec2 c = ((vec2(p) + 0.5) / vec2(uSize) - 0.5) * uHalfDiagScale;
        float rad = length(c);
        if ((uVigMode & 1) != 0) gain *= mix(1.0, texture(uVigLut, rad).r, uProfileVigStrength);
        if ((uVigMode & 2) != 0) gain *= max(0.05, 1.0 + uVigAmount * pow(rad, mix(1.0, 4.0, uVigMidpoint)));
    }
    vec3 work = uCamToWork * (wb * gain);
    imageStore(uDst, p, vec4(work, 1.0));
}
